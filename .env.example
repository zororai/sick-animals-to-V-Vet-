# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible chat completions API) ---
LLM_API_KEY=
# Leave empty for api.openai.com, or point at another compatible provider,
# e.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# json_schema = strict structured output; json_object = plain JSON mode
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=30
# Total attempts when the LLM fails or returns invalid output
LLM_MAX_ATTEMPTS=2

# --- Speech-to-text (optional, for /extract-audio) ---
# Falls back to LLM_API_KEY / LLM_BASE_URL when empty.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT_SECONDS=60

# --- Limits ---
MAX_MESSAGE_CHARS=2000
# 10 MB
MAX_AUDIO_BYTES=10485760

LOG_LEVEL=INFO
